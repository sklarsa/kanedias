# Copy to .env (gitignored) and fill in to run the live Incus/E2E tests:
#   cp .env.example .env && make test-live
#
# The hermetic suite (`make test`) needs none of these. These variables gate
# the destructive `//go:build incus` live tests, which require a running Incus
# daemon and a disposable GitHub repository they are allowed to push to.

# Path to the kanedias config the live tests should load.
KANEDIAS_CONFIG=./config.toml

# --- Live recursive supervisor acceptance test (destructive) ---
# Explicit opt-in gates. The Incus gate alone never authorizes GitHub writes.
KANEDIAS_LIVE_SUPERVISOR=1
KANEDIAS_E2E_PROVIDER_READY=1
KANEDIAS_E2E_DISPOSABLE_GITHUB=1

# Disposable fixture repo the live tests clone and push to. Use a private,
# throwaway repo — NEVER a real project. See sklarsa/kanedias-testing.
KANEDIAS_E2E_GITHUB_REPOSITORY=sklarsa/kanedias-testing
KANEDIAS_E2E_GITHUB_REMOTE=https://github.com/sklarsa/kanedias-testing.git

# --- Other live gates (enable per test as needed) ---
# KANEDIAS_LIVE_IMAGE_CREATE=1   # live image creation smoke test
# KANEDIAS_LIVE_NESTED_INCUS=1   # native nested Incus test
# KANEDIAS_LIVE_BTRFS_POOL=      # btrfs storage pool name for pool-specific tests
